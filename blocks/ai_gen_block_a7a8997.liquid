{% doc %}
  @prompt
    quote
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-quote-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {% if block.settings.rounded_corners %}{{ block.settings.border_radius }}px{% else %}0{% endif %};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-quote-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-quote-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.icon_spacing }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-quote-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.quote_size }}px;
    line-height: {{ block.settings.line_height }};
    color: {{ block.settings.quote_color }};
    margin: 0 0 {{ block.settings.quote_spacing }}px;
    font-style: {% if block.settings.italic_quote %}italic{% else %}normal{% endif %};
  }

  .ai-quote-author-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_size }}px;
    color: {{ block.settings.author_color }};
    margin: 0;
    font-weight: {% if block.settings.bold_author %}bold{% else %}normal{% endif %};
  }

  .ai-quote-divider-{{ ai_gen_id }} {
    width: {{ block.settings.divider_width }}px;
    height: {{ block.settings.divider_height }}px;
    background-color: {{ block.settings.divider_color }};
    margin: {{ block.settings.divider_spacing }}px auto;
    border-radius: {{ block.settings.divider_height }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-quote-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
    }

    .ai-quote-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.quote_size | times: 0.85 }}px;
    }

    .ai-quote-author-{{ ai_gen_id }} {
      font-size: {{ block.settings.author_size | times: 0.9 }}px;
    }

    .ai-quote-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-quote-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-quote-container-{{ ai_gen_id }}">
    {% if block.settings.show_icon %}
      <div class="ai-quote-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z"/>
        </svg>
      </div>
    {% endif %}

    {% if block.settings.quote_text != blank %}
      <blockquote class="ai-quote-text-{{ ai_gen_id }}">
        {{ block.settings.quote_text }}
      </blockquote>
    {% endif %}

    {% if block.settings.show_divider and block.settings.author != blank %}
      <div class="ai-quote-divider-{{ ai_gen_id }}"></div>
    {% endif %}

    {% if block.settings.author != blank %}
      <cite class="ai-quote-author-{{ ai_gen_id }}">
        {{ block.settings.author }}
      </cite>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Quote",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Quote text",
      "default": "The best way to predict the future is to create it."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max content width",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 800
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Quote icon"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "icon_spacing",
      "label": "Space below icon",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#e1ff00"
    },
    {
      "type": "header",
      "content": "Quote text"
    },
    {
      "type": "range",
      "id": "quote_size",
      "label": "Font size",
      "min": 14,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.5
    },
    {
      "type": "range",
      "id": "quote_spacing",
      "label": "Space below quote",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "checkbox",
      "id": "italic_quote",
      "label": "Italic text",
      "default": true
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Text color",
      "default": "#0c0c0f"
    },
    {
      "type": "header",
      "content": "Author"
    },
    {
      "type": "range",
      "id": "author_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "bold_author",
      "label": "Bold text",
      "default": false
    },
    {
      "type": "color",
      "id": "author_color",
      "label": "Text color",
      "default": "#0c0c0f"
    },
    {
      "type": "header",
      "content": "Divider"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider",
      "default": true
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "Width",
      "min": 20,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "divider_height",
      "label": "Height",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "divider_spacing",
      "label": "Spacing",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Color",
      "default": "#e1ff00"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "rounded_corners",
      "label": "Rounded corners",
      "default": false
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Quote"
    }
  ]
}
{% endschema %}