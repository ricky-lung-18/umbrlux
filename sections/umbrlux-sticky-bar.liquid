
{% 'umbrlux-sticky-bar.css' | asset_url | stylesheet_tag %}
<div class="umbrlux-sticky-bar{% unless section.settings.stickybar_enabled %} hide{% endunless %}">
    
</div>


{% schema %}
{
  "name": "Umbrlux Sticky Bar",
  "settings": [
    {
      "id": "stickybar_enabled",
      "label": "Show/Hide Sticky Bar",
      "type": "checkbox",
      "default": true
    },
    {
        "type": "header",
        "content": "Sticky Bar Content"
    },
    {
        "type": "text",
        "id": "text",
        "label": "Text"
    },
    {
        "type": "url",
        "id": "link",
        "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "",
      "settings": {}
    }
  ]
}
{% endschema %}
