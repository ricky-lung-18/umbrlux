{%- comment -%} ========== CONSOLIDATED QR CREST BUILDER MODULE ========== {%- endcomment -%}
<script>
(function () {
  'use strict';

  // ============================================================
  // CONFIG
  // ============================================================
  const QR_POSITIONS = {
    Signature: { side: 'front', left: 270, top: 135, width: 45, height: 45 },
    Statement: { side: 'back',  left: 255, top: 190, width: 72, height: 72 },
    Authority: { side: 'back',  left: 255, top: 180, width: 88, height: 88 },
    Mark:      { side: 'front', left: 340, top: 145, width: 45, height: 45 }
  };

  const PLACEMENT_LABELS = {
    Signature: 'FRONT NECK \u00B7 2"',
    Statement: 'BACK CENTER \u00B7 4.5"',
    Authority: 'BACK CENTER \u00B7 5.5"',
    Mark:      'LEFT BREAST \u00B7 2.5"'
  };

  // ---------- CREST VISUAL CONSTANTS ----------
  const CREST = {
    tealColor:    '#1DCDB5',
    cardColor:    '#FFFFFF',
    centerBg:     '#1f1f1f',
    centerText:   '#c19a5b',
    brandText:    '#1a3a8f',

    cardPadding:    0.05,
    tabOffsetX:    -0.16,
    tabOffsetY:     0.16,
    centerSize:     0.26,
    centerTextSize: 0.055,
    brandFontSize:  0.085,
    brandPadX:      0.06,
    brandPadY:      0.01
  };

  // ---------- MEMORABLE COLORS (hardcoded — city names) ----------
  // California/Yellow removed per Ray 5/22 (was the odd one out).
  const MEMORABLE_COLORS = [
    { label: 'Chicago',  hex: '#08EFC0' },
    { label: 'LA',       hex: '#FA6605' },
    { label: 'Paris',    hex: '#2C10CF' },
    { label: 'Spain',    hex: '#F7868D' },
    { label: 'Miami',    hex: '#D96F76' },
    { label: 'London',   hex: '#A655C0' },
    { label: 'New York', hex: '#E54B20' }
  ];

  // ---------- UPLOAD CONSTRAINTS ----------
  const UPLOAD_MAX_BYTES   = 5 * 1024 * 1024; // 5 MB
  const UPLOAD_MIME_TYPES  = ['image/png', 'image/jpeg', 'image/svg+xml'];
  const UPLOAD_STORAGE_KEY = 'umbrlux_uploaded_qr';
  const UPLOAD_MAX_DIMENSION = 800; // cropped output capped at 800x800 PNG

  // ---------- CTA TEXT ----------
  const PRICE_LABEL    = '{{ product.price | money }}';
  const CTA_READY_TEXT = 'Add to Cart \u00B7 ' + PRICE_LABEL;
  const CTA_NEED_SIZE  = 'Select a size';

  const FRONT_IMAGE_URL  = 'https:' + {{ product.metafields.custom.front_image | image_url | json }};
  const BACK_IMAGE_URL   = 'https:' + {{ product.metafields.custom.back_image  | image_url | json }};
  const VARIANT_ID       = {{ product.selected_or_first_available_variant.id }};
  const PRODUCT_VARIANTS = {{ product.variants | json }};

  // ============================================================
  // STATE
  // ============================================================
  const state = {
    canvas: null,
    productFront: null,
    productBack: null,
    currentSide: 'front',
    currentQRLink: '',
    qrSource: 'generated',        // 'generated' | 'uploaded'
    uploadedQRDataUrl: '',         // cropped square data URL of uploaded QR
    uploadedQRFilename: '',
    uploadedQRDecodedUrl: '',      // URL decoded from the uploaded QR (or '')
    selectedQRColor: '#000000',
    selectedContrast: 'black',
    selectedQRBgColor: '#08EFC0',
    selectedQRColorLabel: '',
    selectedQRSize: '',
    selectedQRStyle: '',
    isInitialized: false
  };

  // ============================================================
  // DOM REFERENCES
  // ============================================================
  const dom = {};

  function cacheDom() {
    dom.canvas             = document.getElementById('mockup-canvas');
    dom.placementBadge     = document.getElementById('placement-badge');
    dom.printSideSelect    = document.getElementById('print-side-select');
    dom.qrLinkInput        = document.getElementById('qr-link-input');
    dom.qrLinkDisplay      = document.getElementById('qr-link-display');
    dom.qrSourceDisplay    = document.getElementById('qr-source-display');
    dom.qrColorDisplay     = document.getElementById('qr-color-display');
    dom.qrCardColorDisplay = document.getElementById('qr-card-color-display');
    dom.qrStyleDisplay     = document.getElementById('qr-style-display');
    dom.qrCrestColorLabel  = document.getElementById('qr-crest-color');
    dom.qrHexDisplay       = document.getElementById('qr-hex-display');
    dom.colorHero          = document.getElementById('color-hero');
    dom.qrPosX             = document.getElementById('qr-pos-x');
    dom.qrPosY             = document.getElementById('qr-pos-y');
    dom.saveQrBtn          = document.getElementById('save-qr-btn');
    dom.placeOrderBtn      = document.getElementById('place-order-btn');
    dom.sizeButtons        = document.querySelectorAll('.size-btn');
    dom.colorBoxes         = document.querySelectorAll('.color-box');
    dom.viewTabs           = document.querySelectorAll('.view-tab');
    dom.qrStyleButtons     = document.querySelectorAll('.qr_code button');
    dom.contrastButtons    = document.querySelectorAll('.qr-contrast button[data-contrast]');

    // QR source tabs
    dom.sourceTabs         = document.querySelectorAll('.qr-source-tab');
    dom.sourcePanels       = document.querySelectorAll('.qr-source-panel');

    // Upload trigger + modal
    dom.uploadTrigger      = document.getElementById('qr-upload-trigger');
    dom.uploadModal        = document.getElementById('qr-upload-modal');
    dom.uploadClose        = document.getElementById('qr-upload-close');
    dom.uploadCancel       = document.getElementById('qr-upload-cancel');
    dom.uploadSave         = document.getElementById('qr-upload-save');
    dom.uploadInput        = document.getElementById('qr-upload-input');
    dom.uploadDropzone     = document.getElementById('qr-upload-dropzone');
    dom.uploadError        = document.getElementById('qr-upload-error');
    dom.uploadProcessing   = document.getElementById('qr-upload-processing');
    dom.uploadPreview      = document.getElementById('qr-upload-preview');
    dom.uploadPreviewImg   = document.getElementById('qr-upload-preview-img');
    dom.uploadFilename     = document.getElementById('qr-upload-filename');
    dom.uploadDecoded      = document.getElementById('qr-upload-decoded');
  }

  // ============================================================
  // IMAGE PROCESSING HELPERS
  // ============================================================

  /**
   * Load a data URL into an Image element, returns Promise<HTMLImageElement>.
   */
  function loadImage(dataUrl) {
    return new Promise(function (resolve, reject) {
      const img = new Image();
      img.onload = function () { resolve(img); };
      img.onerror = function () { reject(new Error('Failed to load image.')); };
      img.src = dataUrl;
    });
  }

  /**
   * Center-crop an image (provided as data URL) to a square, capped at
   * UPLOAD_MAX_DIMENSION on each side. Output is a PNG data URL.
   * SVG inputs are returned unchanged (vector, scales cleanly).
   */
  function cropImageToSquare(dataUrl) {
    // SVG bypass — fabric.js will scale the vector to whatever size we need.
    if (typeof dataUrl === 'string' && dataUrl.indexOf('data:image/svg+xml') === 0) {
      return Promise.resolve(dataUrl);
    }

    return loadImage(dataUrl).then(function (img) {
      const srcW = img.naturalWidth || img.width;
      const srcH = img.naturalHeight || img.height;
      const side = Math.min(srcW, srcH);
      const sx   = Math.floor((srcW - side) / 2);
      const sy   = Math.floor((srcH - side) / 2);

      const out = Math.min(side, UPLOAD_MAX_DIMENSION);

      const canvas  = document.createElement('canvas');
      canvas.width  = out;
      canvas.height = out;
      const ctx = canvas.getContext('2d');

      // White background — preserves the QR quiet zone if source has alpha.
      ctx.fillStyle = '#FFFFFF';
      ctx.fillRect(0, 0, out, out);

      ctx.drawImage(img, sx, sy, side, side, 0, 0, out, out);

      // PNG keeps QR modules crisp (no JPEG compression artifacts).
      return canvas.toDataURL('image/png');
    });
  }

  /**
   * Decode the QR content from a data URL. Returns a Promise that
   * resolves to the decoded string (URL/text), or null if no QR is
   * detected. SVG inputs are rasterized via Image first.
   *
   * Uses jsQR (loaded via CDN script tag above).
   */
  function decodeQRFromDataUrl(dataUrl) {
    if (typeof jsQR === 'undefined') {
      console.warn('jsQR not loaded — skipping QR decode.');
      return Promise.resolve(null);
    }

    return loadImage(dataUrl).then(function (img) {
      const w = img.naturalWidth || img.width;
      const h = img.naturalHeight || img.height;
      if (!w || !h) return null;

      // Cap decode resolution for performance. jsQR scales well up to ~800px.
      const scale = Math.min(1, 800 / Math.max(w, h));
      const decodeW = Math.max(1, Math.round(w * scale));
      const decodeH = Math.max(1, Math.round(h * scale));

      const canvas  = document.createElement('canvas');
      canvas.width  = decodeW;
      canvas.height = decodeH;
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = '#FFFFFF';
      ctx.fillRect(0, 0, decodeW, decodeH);
      ctx.drawImage(img, 0, 0, decodeW, decodeH);

      const imageData = ctx.getImageData(0, 0, decodeW, decodeH);

      // Try a few options to be robust to inverted (white-on-black) QRs
      let result = jsQR(imageData.data, decodeW, decodeH, {
        inversionAttempts: 'attemptBoth'
      });

      return (result && result.data) ? result.data : null;
    }).catch(function (err) {
      console.warn('QR decode failed:', err);
      return null;
    });
  }

  // ============================================================
  // RENDER MEMORABLE COLOR SWATCHES
  // ============================================================
  function renderMemorableColors() {
    const container = document.getElementById('qr-colors');
    if (!container) return;

    container.innerHTML = '';

    MEMORABLE_COLORS.forEach(function (c) {
      const box = document.createElement('div');
      box.className       = 'color-box';
      box.dataset.color   = c.label.toLowerCase();
      box.dataset.hex     = c.hex;
      box.dataset.label   = c.label;
      box.title           = c.label;
      box.style.background = c.hex;
      box.textContent     = c.label;
      container.appendChild(box);
    });

    dom.colorBoxes = document.querySelectorAll('.color-box');
    dom.colorBoxes.forEach(function (box) {
      box.addEventListener('click', handleColorClick);
    });
  }

  // ============================================================
  // VARIANT RESOLVER (size-only)
  // ============================================================
  function resolveVariantId() {
    if (!Array.isArray(PRODUCT_VARIANTS) || PRODUCT_VARIANTS.length === 0) {
      return VARIANT_ID;
    }

    const wantSize = (state.selectedQRSize || '').toString().toLowerCase().trim();
    if (!wantSize) return null;

    const match = PRODUCT_VARIANTS.find(function (v) {
      const opts = (v.options || []).map(function (o) {
        return (o || '').toString().toLowerCase().trim();
      });
      return opts.indexOf(wantSize) !== -1 && v.available !== false;
    });

    if (match) {
      console.log('Resolved variant:', match.id, 'options:', match.options);
      return match.id;
    }

    console.warn('No available variant for size=', wantSize);
    return null;
  }

  // ============================================================
  // ADD-TO-CART BUTTON STATE
  // ============================================================
  function updatePlaceOrderState() {
    if (!dom.placeOrderBtn) return;

    const hasSize = !!state.selectedQRSize;

    if (hasSize) {
      dom.placeOrderBtn.disabled = false;
      dom.placeOrderBtn.innerText = CTA_READY_TEXT;
    } else {
      dom.placeOrderBtn.disabled = true;
      dom.placeOrderBtn.innerText = CTA_NEED_SIZE;
    }
  }

  // ============================================================
  // SIZE AVAILABILITY
  // ============================================================
  function updateSizeAvailability() {
    if (!Array.isArray(PRODUCT_VARIANTS) || PRODUCT_VARIANTS.length === 0) return;

    let activeSizeStillAvailable = true;

    dom.sizeButtons.forEach(function (btn) {
      const size = (btn.dataset.size || '').toString().toLowerCase().trim();

      const variant = PRODUCT_VARIANTS.find(function (v) {
        const opts = (v.options || []).map(function (o) {
          return (o || '').toString().toLowerCase().trim();
        });
        return opts.indexOf(size) !== -1;
      });

      const isAvailable = variant && variant.available !== false;

      if (isAvailable) {
        btn.disabled = false;
        btn.classList.remove('sold-out');
      } else {
        btn.disabled = true;
        btn.classList.add('sold-out');

        if (state.selectedQRSize &&
            state.selectedQRSize.toString().toLowerCase().trim() === size) {
          activeSizeStillAvailable = false;
        }
      }
    });

    if (!activeSizeStillAvailable) {
      state.selectedQRSize = '';
      dom.sizeButtons.forEach(function (b) {
        b.style.background = '#fff';
        b.style.color = '#000';
      });
      const firstAvailable = Array.from(dom.sizeButtons).find(function (b) {
        return !b.disabled;
      });
      if (firstAvailable) firstAvailable.click();
      updatePlaceOrderState();
    }
  }

  // ============================================================
  // CANVAS INIT
  // ============================================================
  function initCanvas() {
    // Restore previous saved QR link (from localStorage as before)
    const savedQR = localStorage.getItem('qr_link');
    if (savedQR) {
      state.currentQRLink = savedQR;
      if (dom.qrLinkDisplay) dom.qrLinkDisplay.textContent = savedQR;
      if (dom.qrLinkInput) dom.qrLinkInput.value = savedQR;
    }

    // Restore previously uploaded QR from sessionStorage
    try {
      const uploadedRaw = sessionStorage.getItem(UPLOAD_STORAGE_KEY);
      if (uploadedRaw) {
        const uploaded = JSON.parse(uploadedRaw);
        if (uploaded && uploaded.dataUrl) {
          state.uploadedQRDataUrl   = uploaded.dataUrl;
          state.uploadedQRFilename  = uploaded.filename || '';
          state.uploadedQRDecodedUrl = uploaded.decodedUrl || '';
          state.qrSource            = 'uploaded';

          // Surface the decoded URL (if any) in the details "Link" row;
          // otherwise fall back to the filename so the user sees something.
          const linkText = state.uploadedQRDecodedUrl || state.uploadedQRFilename || 'Uploaded QR';
          if (dom.qrLinkDisplay)   dom.qrLinkDisplay.textContent = linkText;
          if (dom.qrSourceDisplay) dom.qrSourceDisplay.textContent = 'Uploaded';
          updateUploadTriggerLabel();
        }
      }
    } catch (e) {
      console.warn('Could not restore uploaded QR from sessionStorage:', e);
    }

    if (state.isInitialized) return;

    state.canvas = new fabric.Canvas('mockup-canvas');
    state.canvas.selection = false;
    state.canvas.preserveObjectStacking = true;
    state.canvas.skipTargetFind = true;
    state.canvas.renderOnAddRemove = true;

    loadGarmentImages();

    state.isInitialized = true;
  }

  function applyDefaults() {
    const blackBtn = document.querySelector('.qr-contrast button[data-contrast="black"]');
    if (blackBtn) blackBtn.click();

    const firstColor = document.querySelector('.color-box');
    if (firstColor) firstColor.click();

    updateSizeAvailability();
    const firstAvailableSize = document.querySelector('.size-btn:not(:disabled)');
    if (firstAvailableSize) firstAvailableSize.click();
  }

  function loadGarmentImages() {
    if (FRONT_IMAGE_URL && FRONT_IMAGE_URL !== 'https:') {
      fabric.Image.fromURL(FRONT_IMAGE_URL, function (img) {
        img.selectable = false;
        img.evented = false;
        img.set({
          scaleX: state.canvas.width / img.width,
          scaleY: state.canvas.height / img.height
        });
        state.productFront = img;
        state.canvas.add(img);
        state.canvas.sendToBack(img);
      });
    }

    if (BACK_IMAGE_URL && BACK_IMAGE_URL !== 'https:') {
      fabric.Image.fromURL(BACK_IMAGE_URL, function (img) {
        img.selectable = false;
        img.evented = false;
        img.set({
          scaleX: state.canvas.width / img.width,
          scaleY: state.canvas.height / img.height
        });
        state.productBack = img;
        img.visible = false;
        state.canvas.add(img);
        state.canvas.sendToBack(img);
      });
    }
  }

  // ============================================================
  // VIEW SWITCHING
  // ============================================================
  function showSide(side) {
    state.currentSide = side;
    if (state.productFront) state.productFront.visible = (side === 'front');
    if (state.productBack)  state.productBack.visible  = (side === 'back');

    state.canvas.getObjects().forEach(function (obj) {
      if (obj.isQR) obj.visible = (obj.side === side);
    });

    state.canvas.renderAll();

    if (dom.viewTabs && dom.viewTabs.length === 2) {
      dom.viewTabs[0].classList.toggle('active', side === 'front');
      dom.viewTabs[1].classList.toggle('active', side === 'back');
    }
  }

  // ============================================================
  // QR IMAGE RESOLVER
  //
  // Returns the QR image URL/dataURL that should be rendered on the
  // crest. Uploaded path uses the (already cropped) data URL directly.
  // Generated path produces a fresh QR for the current URL + contrast.
  // ============================================================
  function resolveQRImage(callback) {
    if (state.qrSource === 'uploaded' && state.uploadedQRDataUrl) {
      callback(null, state.uploadedQRDataUrl);
      return;
    }

    const qrDark  = (state.selectedContrast === 'white') ? '#FFFFFF' : '#000000';
    const qrLight = (state.selectedContrast === 'white') ? '#000000' : '#FFFFFF';

    QRCode.toDataURL(state.currentQRLink, {
      width: 400,
      margin: 0,
      errorCorrectionLevel: 'H',
      color: { dark: qrDark, light: qrLight }
    }, callback);
  }

  // ============================================================
  // QR CREST RENDERING
  // ============================================================
  function addQR(style) {
    const hasInput = (state.qrSource === 'uploaded' && state.uploadedQRDataUrl) ||
                     (state.qrSource === 'generated' && state.currentQRLink && state.currentQRLink.trim());

    if (!hasInput) {
      alert('Please add or upload a QR first before choosing a crest position.');
      return;
    }

    state.selectedQRStyle = style;
    const pos = QR_POSITIONS[style];

    if (dom.placementBadge && PLACEMENT_LABELS[style]) {
      dom.placementBadge.textContent = PLACEMENT_LABELS[style];
    }

    if (dom.printSideSelect) {
      dom.printSideSelect.value = pos.side;
      showSide(pos.side);
    }

    // Clear any existing crest on the canvas
    state.canvas.getObjects().forEach(function (obj) {
      if (obj.isQR) state.canvas.remove(obj);
    });

    resolveQRImage(function (err, url) {
      if (err) { console.error(err); return; }

      fabric.Image.fromURL(url, function (qrImg) {
        const qrW       = pos.width;
        const pad       = qrW * CREST.cardPadding;
        const cardSide  = qrW + pad * 2;
        const tabDx     = qrW * CREST.tabOffsetX;
        const tabDy     = qrW * CREST.tabOffsetY;

        const tabW = cardSide;
        const tabH = cardSide;

        const centerSize = qrW * CREST.centerSize;
        const qrCenterX  = -tabDx + pad + qrW / 2;
        const qrCenterY  = -tabDy + pad + qrW / 2;

        const cardX = -tabDx;
        const cardY = -tabDy;

        const qrLight = (state.selectedContrast === 'white') ? '#000000' : '#FFFFFF';

        const children = [];

        children.push(new fabric.Rect({
          width: tabW, height: tabH,
          fill: state.selectedQRBgColor,
          left: 0, top: 0,
          originX: 'left', originY: 'top'
        }));

        children.push(new fabric.Text('UMBRLUX', {
          left: CREST.brandPadX * qrW,
          top:  tabH - CREST.brandPadY * qrW,
          fontSize: qrW * CREST.brandFontSize,
          fontFamily: 'Helvetica, Arial, sans-serif',
          fontWeight: '700',
          fill: CREST.brandText,
          charSpacing: 80,
          originX: 'left', originY: 'bottom'
        }));

        children.push(new fabric.Rect({
          width: cardSide, height: cardSide,
          fill: qrLight,
          left: cardX, top: cardY,
          originX: 'left', originY: 'top'
        }));

        // The uploaded QR image is guaranteed square (cropped on save),
        // so scaleToWidth produces a square render. The generated path
        // is also always square. No aspect-ratio surprises.
        qrImg.set({
          left: cardX + pad,
          top:  cardY + pad,
          originX: 'left', originY: 'top'
        });
        qrImg.scaleToWidth(qrW);
        children.push(qrImg);

        const badgeBg   = (state.selectedContrast === 'white') ? '#FFFFFF' : CREST.centerBg;
        const badgeText = (state.selectedContrast === 'white') ? '#1f1f1f' : CREST.centerText;

        children.push(new fabric.Rect({
          width: centerSize, height: centerSize,
          fill: badgeBg,
          left: qrCenterX, top: qrCenterY,
          originX: 'center', originY: 'center'
        }));

        children.push(new fabric.Text('CARPE\nDIEM', {
          left: qrCenterX, top: qrCenterY,
          textAlign: 'center',
          fontSize: qrW * CREST.centerTextSize,
          fontFamily: 'Georgia, "Times New Roman", serif',
          fontStyle: 'italic',
          fill: badgeText,
          charSpacing: 80,
          originX: 'center', originY: 'center'
        }));

        const qrGroup = new fabric.Group(children, {
          left: pos.left,
          top:  pos.top,
          originX: 'left',
          originY: 'top',
          selectable: false,
          evented: false,
          hasControls: false,
          hasBorders: false,
          hoverCursor: 'default',
          lockMovementX: true,
          lockMovementY: true,
          lockScalingX: true,
          lockScalingY: true,
          lockRotation: true,
          isQR: true,
          style: style,
          side: pos.side
        });

        state.canvas.add(qrGroup);
        state.canvas.renderAll();
        updatePositionInputs(qrGroup);
      });
    });
  }

  function updatePositionInputs(qr) {
    if (!qr) return;
    if (dom.qrPosX) dom.qrPosX.value = Math.round(qr.left);
    if (dom.qrPosY) dom.qrPosY.value = Math.round(qr.top);
  }

  function recolorActiveQR() {
    let activeQR = null;
    state.canvas.getObjects().forEach(function (obj) {
      if (obj.isQR) activeQR = obj;
    });

    if (activeQR && activeQR.style) {
      addQR(activeQR.style);
    }
  }

  // ============================================================
  // FORM CONTROLS
  // ============================================================
  function saveQRLink() {
    const inputValue = dom.qrLinkInput.value.trim();
    if (!inputValue) { alert('Please enter a valid QR link.'); return; }
    state.currentQRLink = inputValue;
    state.qrSource = 'generated';

    // Clear any uploaded QR so the generated one takes precedence
    state.uploadedQRDataUrl   = '';
    state.uploadedQRFilename  = '';
    state.uploadedQRDecodedUrl = '';
    try { sessionStorage.removeItem(UPLOAD_STORAGE_KEY); } catch (e) {}

    localStorage.setItem('qr_link', state.currentQRLink);
    if (dom.qrLinkDisplay)    dom.qrLinkDisplay.textContent = state.currentQRLink;
    if (dom.qrSourceDisplay)  dom.qrSourceDisplay.textContent = 'Generated';
    updateUploadTriggerLabel();
    recolorActiveQR();
    alert('QR Link Saved Successfully!');
  }

  function handleSizeClick(e) {
    const btn = e.currentTarget;

    if (btn.disabled || btn.classList.contains('sold-out')) return;

    state.selectedQRSize = btn.dataset.size;
    dom.sizeButtons.forEach(function (b) { b.style.background = '#fff'; b.style.color = '#000'; });
    btn.style.background = '#000';
    btn.style.color = '#fff';

    updatePlaceOrderState();
  }

  function handleColorClick(e) {
    const box = e.currentTarget;
    const label = box.dataset.label || box.title || box.dataset.color;
    const hex   = box.dataset.hex || box.dataset.color;

    state.selectedQRBgColor    = hex;
    state.selectedQRColorLabel = label;

    if (dom.qrCrestColorLabel)  dom.qrCrestColorLabel.textContent = label;
    if (dom.qrHexDisplay)       dom.qrHexDisplay.textContent = (hex || '').toString().toUpperCase();
    if (dom.qrCardColorDisplay) dom.qrCardColorDisplay.textContent = label;
    if (dom.colorHero)          dom.colorHero.style.background = hex;

    dom.colorBoxes.forEach(function (b) { b.classList.remove('active'); });
    box.classList.add('active');

    recolorActiveQR();
  }

  function handleContrastClick(e) {
    const btn = e.currentTarget;
    const value = btn.dataset.contrast;

    state.selectedContrast = value;
    state.selectedQRColor = (value === 'white') ? '#FFFFFF' : '#000000';

    dom.contrastButtons.forEach(function (b) { b.classList.remove('active'); });
    btn.classList.add('active');

    if (dom.qrColorDisplay) dom.qrColorDisplay.textContent = value.toUpperCase();
    recolorActiveQR();
  }

  function handleStyleClick(e) {
    const btn = e.currentTarget;
    const style = btn.dataset.qrStyle;

    dom.qrStyleButtons.forEach(function (button) {
      button.classList.remove('active');
    });

    btn.classList.add('active');
    if (dom.qrStyleDisplay) dom.qrStyleDisplay.textContent = style;
    addQR(style);
  }

  function handlePrintSideChange(e) {
    showSide(e.target.value);
  }

  function handleViewTabClick(index) {
    showSide(index === 0 ? 'front' : 'back');
  }

  // ============================================================
  // QR SOURCE TAB SWITCHING (Generate / Upload)
  // ============================================================
  function handleSourceTabClick(e) {
    const tab = e.currentTarget;
    const which = tab.dataset.sourceTab;

    dom.sourceTabs.forEach(function (t) { t.classList.toggle('active', t === tab); });
    dom.sourcePanels.forEach(function (p) {
      p.classList.toggle('active', p.dataset.sourcePanel === which);
    });
  }

  // ============================================================
  // QR UPLOAD MODAL
  // ============================================================
  let pendingUpload = null; // { dataUrl, filename, decodedUrl } before user clicks Save

  function openUploadModal() {
    if (!dom.uploadModal) return;

    if (state.uploadedQRDataUrl) {
      pendingUpload = {
        dataUrl:    state.uploadedQRDataUrl,
        filename:   state.uploadedQRFilename,
        decodedUrl: state.uploadedQRDecodedUrl
      };
      showPreview(pendingUpload);
    } else {
      pendingUpload = null;
      hidePreview();
    }

    hideUploadError();
    hideProcessing();
    dom.uploadModal.classList.add('is-open');
    dom.uploadModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeUploadModal() {
    if (!dom.uploadModal) return;
    dom.uploadModal.classList.remove('is-open');
    dom.uploadModal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    pendingUpload = null;
    hideUploadError();
    hideProcessing();
  }

  function showUploadError(msg) {
    if (!dom.uploadError) return;
    dom.uploadError.textContent = msg;
    dom.uploadError.classList.add('is-shown');
  }
  function hideUploadError() {
    if (!dom.uploadError) return;
    dom.uploadError.classList.remove('is-shown');
    dom.uploadError.textContent = '';
  }

  function showProcessing() {
    if (dom.uploadProcessing) dom.uploadProcessing.classList.add('is-shown');
  }
  function hideProcessing() {
    if (dom.uploadProcessing) dom.uploadProcessing.classList.remove('is-shown');
  }

  function showPreview(payload) {
    if (!dom.uploadPreview || !dom.uploadPreviewImg) return;

    dom.uploadPreviewImg.src = payload.dataUrl;
    dom.uploadFilename.textContent = payload.filename || '';

    // Decoded URL panel — green if decoded, amber warning if not
    if (dom.uploadDecoded) {
      if (payload.decodedUrl) {
        dom.uploadDecoded.innerHTML =
          '<strong>QR Decoded</strong>' +
          escapeHtml(payload.decodedUrl);
        dom.uploadDecoded.classList.remove('is-warn');
        dom.uploadDecoded.classList.add('is-shown');
      } else {
        dom.uploadDecoded.innerHTML =
          '<strong>Heads up</strong>' +
          'We could not detect a scannable QR pattern in this image. ' +
          'The image will still be used on your crest, but please double-check it scans.';
        dom.uploadDecoded.classList.add('is-warn');
        dom.uploadDecoded.classList.add('is-shown');
      }
    }

    dom.uploadPreview.classList.add('is-shown');
    if (dom.uploadSave) dom.uploadSave.disabled = false;
  }

  function hidePreview() {
    if (!dom.uploadPreview) return;
    dom.uploadPreview.classList.remove('is-shown');
    if (dom.uploadPreviewImg) dom.uploadPreviewImg.src = '';
    if (dom.uploadFilename) dom.uploadFilename.textContent = '';
    if (dom.uploadDecoded) {
      dom.uploadDecoded.classList.remove('is-shown', 'is-warn');
      dom.uploadDecoded.innerHTML = '';
    }
    if (dom.uploadSave) dom.uploadSave.disabled = true;
  }

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function processUploadedFile(file) {
    hideUploadError();
    hidePreview();

    if (!file) return;

    if (UPLOAD_MIME_TYPES.indexOf(file.type) === -1) {
      showUploadError('Unsupported file type. Please upload a PNG, JPG, or SVG.');
      return;
    }
    if (file.size > UPLOAD_MAX_BYTES) {
      showUploadError('File is too large. Max size is 5 MB.');
      return;
    }

    showProcessing();

    const reader = new FileReader();
    reader.onload = function (ev) {
      const originalDataUrl = ev.target.result;

      // Pipeline:
      //   1. Crop the source to a square (cap at 800px)
      //   2. Try to decode the QR content from the cropped image
      //   3. Show preview with both
      cropImageToSquare(originalDataUrl)
        .then(function (squareDataUrl) {
          return decodeQRFromDataUrl(squareDataUrl).then(function (decodedUrl) {
            pendingUpload = {
              dataUrl:    squareDataUrl,
              filename:   file.name,
              decodedUrl: decodedUrl || ''
            };
            hideProcessing();
            showPreview(pendingUpload);
          });
        })
        .catch(function (err) {
          console.error(err);
          hideProcessing();
          showUploadError('Could not process the image. Please try a different file.');
        });
    };
    reader.onerror = function () {
      hideProcessing();
      showUploadError('Could not read the file. Please try a different image.');
    };
    reader.readAsDataURL(file);
  }

  function saveUploadedQR() {
    if (!pendingUpload || !pendingUpload.dataUrl) return;

    state.uploadedQRDataUrl    = pendingUpload.dataUrl;
    state.uploadedQRFilename   = pendingUpload.filename || 'Uploaded QR';
    state.uploadedQRDecodedUrl = pendingUpload.decodedUrl || '';
    state.qrSource             = 'uploaded';

    // Persist all three (image + filename + decoded URL) so the cart
    // submission and any subsequent page load can use them.
    try {
      sessionStorage.setItem(UPLOAD_STORAGE_KEY, JSON.stringify({
        dataUrl:    state.uploadedQRDataUrl,
        filename:   state.uploadedQRFilename,
        decodedUrl: state.uploadedQRDecodedUrl,
        decodedAt:  Date.now()
      }));
    } catch (e) {
      console.warn('Could not save uploaded QR to sessionStorage:', e);
      showUploadError('Image saved, but could not store for this session.');
    }

    // Surface the decoded URL in the details "Link" row when we have it,
    // otherwise fall back to the filename so the user always sees something.
    const linkText = state.uploadedQRDecodedUrl || state.uploadedQRFilename;
    if (dom.qrLinkDisplay)    dom.qrLinkDisplay.textContent = linkText;
    if (dom.qrSourceDisplay)  dom.qrSourceDisplay.textContent = 'Uploaded';
    updateUploadTriggerLabel();

    // Re-render the active crest with the new QR image
    recolorActiveQR();

    closeUploadModal();
  }

  function updateUploadTriggerLabel() {
    if (!dom.uploadTrigger) return;
    if (state.qrSource === 'uploaded' && state.uploadedQRFilename) {
      dom.uploadTrigger.textContent = '✓ ' + state.uploadedQRFilename + ' (click to change)';
      dom.uploadTrigger.classList.add('has-image');
    } else {
      dom.uploadTrigger.textContent = 'Choose QR image to upload';
      dom.uploadTrigger.classList.remove('has-image');
    }
  }

  function bindUploadModal() {
    if (!dom.uploadTrigger) return;

    dom.uploadTrigger.addEventListener('click', openUploadModal);

    if (dom.uploadClose)  dom.uploadClose.addEventListener('click', closeUploadModal);
    if (dom.uploadCancel) dom.uploadCancel.addEventListener('click', closeUploadModal);

    // Backdrop click closes
    if (dom.uploadModal) {
      const backdrop = dom.uploadModal.querySelector('.modal-backdrop');
      if (backdrop) backdrop.addEventListener('click', closeUploadModal);
    }

    // ESC closes
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && dom.uploadModal && dom.uploadModal.classList.contains('is-open')) {
        closeUploadModal();
      }
    });

    // File picker
    if (dom.uploadInput) {
      dom.uploadInput.addEventListener('change', function (e) {
        const file = e.target.files && e.target.files[0];
        if (file) processUploadedFile(file);
      });
    }

    // Drag + drop on the dropzone label
    if (dom.uploadDropzone) {
      ['dragenter', 'dragover'].forEach(function (evt) {
        dom.uploadDropzone.addEventListener(evt, function (e) {
          e.preventDefault();
          dom.uploadDropzone.classList.add('is-dragging');
        });
      });
      ['dragleave', 'drop'].forEach(function (evt) {
        dom.uploadDropzone.addEventListener(evt, function (e) {
          e.preventDefault();
          dom.uploadDropzone.classList.remove('is-dragging');
        });
      });
      dom.uploadDropzone.addEventListener('drop', function (e) {
        const file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
        if (file) processUploadedFile(file);
      });
    }

    // Save button confirms and persists
    if (dom.uploadSave) {
      dom.uploadSave.addEventListener('click', saveUploadedQR);
    }
  }

  // ============================================================
  // ORDER SUBMISSION
  // ============================================================
  function placeOrder() {
    const hasInput = (state.qrSource === 'uploaded' && state.uploadedQRDataUrl) ||
                     (state.qrSource === 'generated' && state.currentQRLink);
    if (!hasInput) { alert('Please add a QR link or upload a QR image first.'); return; }

    const variantId = resolveVariantId();
    if (!variantId) {
      alert('Sorry, this size is not available. Please pick a different size.');
      return;
    }

    const originalText = dom.placeOrderBtn.innerText;
    dom.placeOrderBtn.innerText = 'Processing...';
    dom.placeOrderBtn.disabled = true;

    let selectedStyle = state.selectedQRStyle;
    if (!selectedStyle) {
      state.canvas.getObjects().forEach(function (obj) {
        if (obj.isQR && obj.style) selectedStyle = obj.style;
      });
    }

    const designId = 'design_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);

    const contrastValue  = (state.selectedContrast || 'black').toUpperCase();
    const cardColorValue = state.selectedQRColorLabel || '—';
    const styleValue     = selectedStyle             || '—';
    const printSideValue = dom.printSideSelect ? dom.printSideSelect.value : 'front';
    const sourceValue    = state.qrSource === 'uploaded' ? 'Uploaded' : 'Generated';

    // For uploaded QRs we send the decoded URL when available so the
    // production team can verify the destination. If decode failed we
    // fall back to the filename so the property is never blank.
    let linkOrFile;
    if (state.qrSource === 'uploaded') {
      linkOrFile = state.uploadedQRDecodedUrl
        ? state.uploadedQRDecodedUrl
        : ('Uploaded: ' + (state.uploadedQRFilename || 'qr-image'));
    } else {
      linkOrFile = state.currentQRLink;
    }

    const properties = {
      'QR Link':            linkOrFile,
      'QR Source':          sourceValue,
      'QR Colour':          contrastValue,
      'Umbrlux Colour':     cardColorValue,
      'QR Position':        styleValue,
      'Print Side':         printSideValue,
      '_design_id':         designId,
      '_has_custom_design': 'true'
    };

    // Extra property for fulfillment when uploaded — keeps filename
    // visible alongside the decoded URL.
    if (state.qrSource === 'uploaded' && state.uploadedQRFilename) {
      properties['QR Filename'] = state.uploadedQRFilename;
    }

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items: [{
          id: variantId,
          quantity: 1,
          properties: properties
        }]
      })
    })
    .then(function (res) {
      return res.json().then(function (data) {
        if (!res.ok) {
          throw new Error(data.description || data.message || 'Cart error ' + res.status);
        }
        return data;
      });
    })
    .then(function (data) {
      console.log('Added to cart:', data);
      window.location.href = '/cart?logged_in=true';
    })
    .catch(function (err) {
      console.error(err);
      alert('Error placing order: ' + err.message);
      dom.placeOrderBtn.innerText = originalText;
      dom.placeOrderBtn.disabled = false;
    });
  }

  // ============================================================
  // EVENT BINDING
  // ============================================================
  function bindEvents() {
    if (dom.saveQrBtn)       dom.saveQrBtn.addEventListener('click', saveQRLink);
    if (dom.placeOrderBtn)   dom.placeOrderBtn.addEventListener('click', placeOrder);
    if (dom.printSideSelect) dom.printSideSelect.addEventListener('change', handlePrintSideChange);

    dom.sizeButtons.forEach(function (btn) { btn.addEventListener('click', handleSizeClick); });
    dom.qrStyleButtons.forEach(function (btn) { btn.addEventListener('click', handleStyleClick); });
    dom.contrastButtons.forEach(function (btn) { btn.addEventListener('click', handleContrastClick); });
    dom.viewTabs.forEach(function (tab, index) {
      tab.addEventListener('click', function () { handleViewTabClick(index); });
    });
    dom.sourceTabs.forEach(function (tab) { tab.addEventListener('click', handleSourceTabClick); });
  }

  // ============================================================
  // INIT
  // ============================================================
  function init() {
    cacheDom();
    bindEvents();
    bindUploadModal();
    initCanvas();
    renderMemorableColors();
    applyDefaults();
    updatePlaceOrderState();

    // If a QR was previously uploaded in this session, switch tab to upload
    if (state.qrSource === 'uploaded') {
      const uploadTab = document.querySelector('.qr-source-tab[data-source-tab="upload"]');
      if (uploadTab) uploadTab.click();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>